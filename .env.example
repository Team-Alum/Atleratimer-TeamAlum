# Copy to .env.local and fill in from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side only (used by api/youtube-search.js, NEVER shipped to the browser).
# Create at: https://console.cloud.google.com/apis/credentials -> YouTube Data API v3 key
# Set on Vercel with: vercel env add YOUTUBE_API_KEY production
# Local search testing:  npx vercel dev  (serves /api/* with the key from .env.local)
YOUTUBE_API_KEY=your_api_key_here
